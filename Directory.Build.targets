<Project>
  <PropertyGroup>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <Target Name="RunBSMake"          
          BeforeTargets="Build;CoreCompile"
          Condition="Exists('$(MSBuildProjectDirectory)\.bsmake\Build.cs')"
          Inputs="@(AssetInputs);.bsmake\**\*.cs;.bsmake\Build.csproj"
          Outputs="@(AssetOutputs)">
    <Exec Command="bsmake build $(MSBuildProjectDirectory)" />
  </Target>
</Project>