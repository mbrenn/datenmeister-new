<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <ItemGroup>
      <!-- Include only source files and configuration -->
      <AssetInputs Include="Assets/**/*.scss" />
      <AssetInputs Include="Assets/**/*.ts" />
      <AssetInputs Include="package.json;tsconfig.json" />

      <!-- Specify concrete generated output files or precise globs -->
      <AssetOutputs Include="wwwroot/css/datenmeister-web.min.css" />
      <AssetOutputs Include="wwwroot/js/**/*.js" />
    </ItemGroup>

    <ItemGroup>
      <None Include=".bsmake\Build.cs" />
    </ItemGroup>

    <ItemGroup>
      <Content Include=".bsmake\Build.csproj" />
      <Content Update="tsconfig.json">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Update="package.json">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="wwwroot\css\bootstrap.min.css" />
    </ItemGroup>

</Project>
